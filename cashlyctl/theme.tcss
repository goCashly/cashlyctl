#right {
    width: 25%;
    layout: vertical;
}

/* top-right row containing schema + network */
#top-right {
    layout: horizontal;
    height: 12;                 /* controls height of the schema + network section */
}

/* the schema map area */
#schema {
    width: 70%;
    border: solid #586e75;
}

/* smaller network status box */
#network {
    width: 30%;
    border: solid #586e75;
}

/* selected files section */
#selected-files {
    height: 6;
    border: solid #586e75;
}

/* log area fills the rest of the column */
#log {
    border: solid #586e75;
    height: 1fr;                /* take remaining vertical space */
}
