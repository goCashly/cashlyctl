CASHLYCTL_LOGIN_ADMIN=change-me
CASHLYCTL_LOGIN_SUPERADMIN=change-me
CASHLYCTL_ROLE_SUPERADMIN=superadmin

# Network targets (choose one style)
# Style A: compact comma-separated list (recommended)
# CASHLYCTL_NETWORK_TARGETS=n8n-server=https://n8n-aws.gocashly.io,cashly-app-development=https://crm-development.gocashly.io,cashly-app-production=https://crm.gocashly.io
#
# Style B: indexed keys
CASHLYCTL_TARGET_1_NAME=n8n-server
CASHLYCTL_TARGET_1_URL=https://n8n-aws.gocashly.io
CASHLYCTL_TARGET_2_NAME=cashly-app-development
CASHLYCTL_TARGET_2_URL=https://crm-development.gocashly.io
CASHLYCTL_TARGET_3_NAME=cashly-app-production
CASHLYCTL_TARGET_3_URL=https://crm.gocashly.io

# AWS drilldown defaults (optional)
CASHLYCTL_AWS_REGION=us-east-1
#
# Per-target overrides (target name transformed to uppercase with non-alnum -> underscore)
# Example for target "cashly-app-production":
# CASHLYCTL_AWS_REGION_CASHLY_APP_PRODUCTION=us-east-1
# CASHLYCTL_AWS_INSTANCE_ID_CASHLY_APP_PRODUCTION=i-xxxxxxxxxxxxxxxxx
# CASHLYCTL_AWS_INSTANCE_NAME_CASHLY_APP_PRODUCTION=cashly-app-production
# CASHLYCTL_AWS_TARGET_GROUP_CASHLY_APP_PRODUCTION=arn:aws:elasticloadbalancing:...
#
# Optional origin override shown in panel
# CASHLYCTL_ORIGIN_CASHLY_APP_PRODUCTION=internal-alb-xxxx.us-east-1.elb.amazonaws.com

# Deployment SSH runner (Panel 7)
# Per-target key format: CASHLYCTL_DEPLOY_<TARGET_KEY>_*
# TARGET_KEY example:
#   n8n-server -> N8N_SERVER
#   cashly-app-development -> CASHLY_APP_DEVELOPMENT
#
# n8n-server
# CASHLYCTL_DEPLOY_N8N_SERVER_HOST=10.20.0.10
# CASHLYCTL_DEPLOY_N8N_SERVER_USER=ubuntu
# CASHLYCTL_DEPLOY_N8N_SERVER_PORT=22
# CASHLYCTL_DEPLOY_N8N_SERVER_SSH_KEY_PATH=~/.ssh/cashlyctl-n8n.pem
# CASHLYCTL_DEPLOY_N8N_SERVER_APP_DIR=/srv/n8n
# CASHLYCTL_DEPLOY_N8N_SERVER_PM2_PROCESS=n8n
# CASHLYCTL_DEPLOY_N8N_SERVER_HEALTH_LOCAL=http://127.0.0.1:5678/healthz
# CASHLYCTL_DEPLOY_N8N_SERVER_HEALTH_PUBLIC=https://n8n-aws.gocashly.io/healthz
# CASHLYCTL_DEPLOY_N8N_SERVER_DEFAULT_REF=origin/main
# CASHLYCTL_DEPLOY_N8N_SERVER_NGINX_RELOAD=0
# CASHLYCTL_DEPLOY_N8N_SERVER_LAST_GOOD=
#
# cashly-app-development
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_HOST=
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_USER=
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_PORT=22
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_SSH_KEY_PATH=~/.ssh/cashlyctl-crm-dev.pem
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_APP_DIR=/srv/cashly-crm
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_PM2_PROCESS=cashly-crm-dev
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_HEALTH_LOCAL=http://127.0.0.1:3000/health
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_HEALTH_PUBLIC=https://crm-development.gocashly.io/health
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_DEFAULT_REF=origin/main
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_NGINX_RELOAD=1
# CASHLYCTL_DEPLOY_CASHLY_APP_DEVELOPMENT_LAST_GOOD=
#
# cashly-app-production
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_HOST=
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_USER=
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_PORT=22
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_SSH_KEY_PATH=~/.ssh/cashlyctl-crm-prod.pem
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_APP_DIR=/srv/cashly-crm
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_PM2_PROCESS=cashly-crm-prod
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_HEALTH_LOCAL=http://127.0.0.1:3000/health
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_HEALTH_PUBLIC=https://crm.gocashly.io/health
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_DEFAULT_REF=origin/main
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_NGINX_RELOAD=1
# CASHLYCTL_DEPLOY_CASHLY_APP_PRODUCTION_LAST_GOOD=

# Optional deploy readiness timeout per check (seconds, default 10)
# CASHLYCTL_DEPLOY_PREFLIGHT_TIMEOUT_SEC=10
