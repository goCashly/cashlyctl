# Optional legacy/dev login fallback.
# Prefer `INITADMIN` in the console for local users.
# CASHLYCTL_LOGIN_ADMIN=replace-with-local-password
# CASHLYCTL_LOGIN_SUPERADMIN=replace-with-local-password
# CASHLYCTL_ROLE_SUPERADMIN=superadmin

# Network targets (choose one style)
# Style A: compact comma-separated list (recommended)
# CASHLYCTL_NETWORK_TARGETS=crm=https://crm.example.com,worker=https://worker.example.com
#
# Style B: indexed keys
# CASHLYCTL_TARGET_1_NAME=crm
# CASHLYCTL_TARGET_1_URL=https://crm.example.com
# CASHLYCTL_TARGET_2_NAME=worker
# CASHLYCTL_TARGET_2_URL=https://worker.example.com

# AWS drilldown defaults (optional)
# CASHLYCTL_AWS_REGION=us-east-1
# Optional profile defaults (for multi-account drilldown)
# CASHLYCTL_AWS_PROFILE=example-admin
#
# Per-target overrides (target name transformed to uppercase with non-alnum -> underscore)
# Example for target "crm":
# CASHLYCTL_AWS_REGION_CRM=us-east-1
# CASHLYCTL_AWS_PROFILE_CRM=example-admin
# CASHLYCTL_AWS_INSTANCE_ID_CRM=i-00000000000000000
# CASHLYCTL_AWS_INSTANCE_NAME_CRM=crm
# CASHLYCTL_AWS_TARGET_GROUP_CRM=arn:aws:elasticloadbalancing:region:account:targetgroup/example/id
#
# Optional origin override shown in panel
# CASHLYCTL_ORIGIN_CRM=internal-service.example.com

# Deployment SSH runner (Panel 7)
# Per-target key format: CASHLYCTL_DEPLOY_<TARGET_KEY>_*
# TARGET_KEY example:
#   crm -> CRM
#   worker -> WORKER
#
# crm
# CASHLYCTL_DEPLOY_CRM_HOST=192.0.2.10
# CASHLYCTL_DEPLOY_CRM_USER=ubuntu
# CASHLYCTL_DEPLOY_CRM_PORT=22
# CASHLYCTL_DEPLOY_CRM_SSH_KEY_PATH=~/.ssh/cashlyctl-crm.pem
# CASHLYCTL_DEPLOY_CRM_APP_DIR=/srv/cashly-crm
# CASHLYCTL_DEPLOY_CRM_PM2_PROCESS=cashly-crm
# CASHLYCTL_DEPLOY_CRM_HEALTH_LOCAL=http://127.0.0.1:3000/health
# CASHLYCTL_DEPLOY_CRM_HEALTH_PUBLIC=https://crm.example.com/health
# CASHLYCTL_DEPLOY_CRM_DEFAULT_REF=origin/main
# CASHLYCTL_DEPLOY_CRM_NGINX_RELOAD=1
# CASHLYCTL_DEPLOY_CRM_LAST_GOOD=

# Optional deploy readiness timeout per check (seconds, default 20)
# CASHLYCTL_DEPLOY_PREFLIGHT_TIMEOUT_SEC=20
